#!/usr/bin/env bash
# Run every check CI enforces, in the order CI runs them.
#
# This is the same gate as CI's `styling` job plus the Zizmor workflow audit.
# Run it before committing.
set -euo pipefail

cd "$(dirname "$0")/.."

ZIZMOR_WORKFLOW=.github/workflows/workflow-security.yml

# The Zizmor version is read from the workflow rather than written here as well.
#
# Two reasons. It was duplicated, so the local gate could drift from CI and the
# drift would be invisible until a new audit rule failed in one place and not
# the other. And Dependabot cannot help: it updates the `uses:` SHA of
# `taiki-e/install-action`, but `tool: zizmor@X.Y.Z` is an input to that action,
# not a dependency manifest, so nothing watches it. One source at least means
# one thing to update by hand.
zizmor_version() {
	local version
	version=$(grep -oE 'zizmor@[0-9]+\.[0-9]+\.[0-9]+' "$ZIZMOR_WORKFLOW" | head -1 | cut -d@ -f2)
	if [ -z "$version" ]; then
		echo "Could not read the pinned Zizmor version from $ZIZMOR_WORKFLOW." >&2
		echo "Expected a line like:  tool: zizmor@1.30.1" >&2
		return 1
	fi
	printf '%s' "$version"
}

if [ -x .venv/bin/pre-commit ]; then
	PRE_COMMIT=.venv/bin/pre-commit
elif command -v pre-commit >/dev/null 2>&1; then
	PRE_COMMIT=pre-commit
else
	echo "pre-commit not found. Install it with:" >&2
	echo "  python -m venv .venv && .venv/bin/pip install pre-commit" >&2
	exit 1
fi

echo "==> pre-commit"
"$PRE_COMMIT" run --all-files --show-diff-on-failure "$@"

# `--all-files` means every file *git knows about*: pre-commit asks git for the
# list, so an untracked file is invisible to it. CI never hits this, because a
# checkout has everything tracked - which makes it precisely the case where a
# green local gate stops predicting a green CI run. It has already cost one red
# build: a new test module and a new migration were formatted by CI's ruff and
# not by ours, because at the time they had never been added.
#
# So check them explicitly. `--files` rather than `git add -N`, because a lint
# script should not reach into the index.
untracked=()
while IFS= read -r -d '' path; do
	untracked+=("$path")
done < <(git ls-files --others --exclude-standard -z)

if [ ${#untracked[@]} -gt 0 ]; then
	echo "==> pre-commit (untracked files, which --all-files does not see)"
	printf '    %s\n' "${untracked[@]}"

	# pre-commit decides a hook "modified files" by diffing against git, which
	# has nothing to say about a file it is not tracking: a formatter rewrites
	# an untracked file and the run still reports Passed. Hash each one either
	# side, so a rewrite is reported and fails the gate the same way it would
	# for a tracked file - and so nobody commits a file they have not seen in
	# the state it was rewritten into.
	before=()
	for path in "${untracked[@]}"; do
		before+=("$(git hash-object -- "$path")")
	done

	status=0
	"$PRE_COMMIT" run --show-diff-on-failure --files "${untracked[@]}" "$@" || status=$?

	rewritten=()
	for i in "${!untracked[@]}"; do
		if [ "$(git hash-object -- "${untracked[$i]}")" != "${before[$i]}" ]; then
			rewritten+=("${untracked[$i]}")
		fi
	done

	if [ ${#rewritten[@]} -gt 0 ]; then
		echo >&2
		echo "A hook rewrote these untracked files:" >&2
		printf '    %s\n' "${rewritten[@]}" >&2
		echo "Review the changes, then run this again." >&2
		status=1
	fi

	[ "$status" -eq 0 ] || exit "$status"
fi

PINNED=$(zizmor_version)
echo "==> zizmor $PINNED (GitHub Actions audit)"

if command -v uvx >/dev/null 2>&1; then
	# Preferred: runs exactly the version CI runs, whatever is installed locally.
	uvx "zizmor@${PINNED}" --strict-collection .
elif command -v zizmor >/dev/null 2>&1; then
	# Fall back to an installed zizmor, but say so if it is not the pinned one.
	# Previously this branch ran whichever version happened to be on PATH and
	# reported nothing, so a local pass did not mean CI would pass.
	INSTALLED=$(zizmor --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
	if [ "$INSTALLED" != "$PINNED" ]; then
		echo "Warning: using zizmor $INSTALLED from PATH, but CI pins $PINNED." >&2
		echo "Findings may differ. Install uv to run the pinned version." >&2
	fi
	zizmor --strict-collection .
else
	echo "zizmor not found and uvx unavailable; skipping the workflow audit." >&2
	echo "CI will still run it. Install uv to run it locally." >&2
fi
