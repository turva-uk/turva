#!/usr/bin/env bash
# Run the test suites.
#
# Two suites exist because they need different environments:
#
#   safety_file/  pure Python. No database, no web framework, no container.
#                 Needs only git. Runs on the host in about two seconds.
#   api/src/      needs PostgreSQL and the application container.
#
# Routing:
#
#   ./s/test                      both suites
#   ./s/test safety_file          host suite only
#   ./s/test safety_file -k risk  host suite, filtered
#   ./s/test -k login             container suite, filtered
#
# An argument naming the safety_file package runs on the host; anything else
# goes to the container, which is where the application tests need a database.
set -euo pipefail

cd "$(dirname "$0")/.."

# Single place to change when the application service is renamed.
SERVICE=api
CONTAINER_TESTS=/app/src

if [ -x .venv/bin/python ]; then
	PYTHON=.venv/bin/python
else
	PYTHON=python3
fi

if [ "$#" -eq 0 ]; then
	echo "==> safety_file (host)"
	"$PYTHON" -m pytest safety_file -q
	echo
	echo "==> api (container)"
	exec docker compose exec -T "$SERVICE" pytest "$CONTAINER_TESTS"
fi

case "$1" in
safety_file | safety_file/* | ./safety_file | ./safety_file/*)
	exec "$PYTHON" -m pytest "$@"
	;;
esac

exec docker compose exec -T "$SERVICE" pytest "$@"
