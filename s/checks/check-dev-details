#!/usr/bin/env bash
# Refuses details of a home or dev set-up in tracked files.
#
# Usage: s/checks/check-dev-details [--all | --warn-if-empty | FILE...]
#
# The repository is public, so a private network address or a device's MAC
# address written into it is published. The patterns here describe a kind of
# detail, never anybody's own, so they are safe to commit, and CI runs them
# on every push.
#
# The literals only a list can know, such as a laptop's hostname or a VPN
# network's name, are in
# local/dev-details-denylist, which is never committed. It is read when this
# runs outside CI, and made with a header explaining it the first time.
# --warn-if-empty prints a strong recommendation while it has no entries,
# and never fails: .githooks/pre-commit runs it after each commit's checks.
#
# A match is reported as path:line and the rule's name, never the text,
# because CI logs are as public as the files.
#
# Safe to run twice: it changes nothing but making the denylist once.
set -euo pipefail

# One octet, and a last octet that is not 0: an address ending .0 names a
# network, not a machine.
octet='(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])'
host_octet='(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]?)'

# The private ranges, and 100.64.0.0/10, the shared range that carrier
# networks and several VPNs assign from. Not followed by a slash, so a CIDR
# passes: a subnet is a design, not a place.
# A full stop ending a sentence still counts as the end.
private_prefix="(10\\.${octet}\\.${octet}|172\\.(1[6-9]|2[0-9]|3[01])\\.${octet}|192\\.168\\.${octet}|100\\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\\.${octet})"
private_address="(^|[^0-9.])${private_prefix}\\.${host_octet}([^0-9./]|\\.([^0-9]|\$)|\$)"

# Six pairs of hex digits, not part of a longer run such as a certificate
# fingerprint.
mac_address='(^|[^0-9a-f:-])([0-9a-f]{2}[:-]){5}[0-9a-f]{2}([^0-9a-f:-]|$)'

rule_names=("private address" "MAC address")
rule_patterns=("${private_address}" "${mac_address}")

denylist_header="# Dev set-up details this machine refuses to commit, one per line.
#
# Read by s/checks/check-dev-details, which pre-commit runs. Put here
# what only a list can know: the hostnames of your own devices, your
# VPN network's name and the start of its addresses, your router's make
# or model, your Wi-Fi name. Matching ignores case. This
# file is in local/, which is never committed, and the check never
# prints what it matched."

# Print the path of the shared local/ folder, in the main checkout, so every
# worktree reads the same denylist. Also make sure git ignores it through
# info/exclude, which applies whatever branch is checked out.
shared_local_folder() {
	local common_dir
	local main_checkout
	local exclude

	common_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
	main_checkout="$(cd -P "$(dirname "${common_dir}")" && pwd)"
	exclude="${common_dir}/info/exclude"

	mkdir -p "${main_checkout}/local" "$(dirname "${exclude}")"
	touch "${exclude}"

	if ! grep -qxF "/local" "${exclude}"; then
		echo "/local" >>"${exclude}"
	fi

	echo "${main_checkout}/local"
}

# Print the denylist's path, making it with its header the first time.
# Print nothing under CI, which has no local/ and needs none.
denylist_path() {
	local path

	if [ -n "${CI:-}" ]; then
		return
	fi

	path="$(shared_local_folder)/dev-details-denylist"

	if [ ! -e "${path}" ]; then
		echo "${denylist_header}" >"${path}"
		echo "Made ${path} for this machine's own dev details." >&2
	fi

	echo "${path}"
}

# Print the denylist's entries, one per line, leaving out its comments and
# blank lines.
denylist_literals() {
	local denylist="$1"

	grep -vE '^[[:space:]]*(#|$)' "${denylist}" || true
}

# Recommend filling the denylist while it has no entries. A header alone
# protects nothing, so an empty file counts the same as a missing one. Never
# fails, so a commit is never stopped by it.
warn_if_empty() {
	local denylist

	denylist="$(denylist_path)"

	if [ -z "${denylist}" ] || [ -n "$(denylist_literals "${denylist}")" ]; then
		return
	fi

	echo "Strongly recommended: add your devices' hostnames, your Wi-Fi name and your router's make or model to" >&2
	echo "  ${denylist}" >&2
	echo "Until then, only the built-in patterns are checked for your dev details." >&2
}

# A test file's addresses are fixtures, made up by definition.
is_exempt() {
	local file="$1"

	case "$(basename "${file}")" in
		test_*.py | *_test.py | *.test.ts | *.test.tsx | *.bats) return 0 ;;
	esac

	return 1
}

# Read grep's -Z output, a file name and NUL then line:text, and print
# path:line with the rule's name. The text is dropped here.
report() {
	local name="$1"
	local file
	local rest

	while IFS= read -r -d '' file && IFS= read -r rest; do
		echo "${file}:${rest%%:*}: dev detail (${name})"
	done
}

# Print every finding in the given files, one per line, sorted.
find_details() {
	local files=("$@")
	local findings=""
	local denylist
	local literals
	local i

	for i in "${!rule_names[@]}"; do
		findings+="$(grep -nIHZiE -- "${rule_patterns[$i]}" "${files[@]}" | report "${rule_names[$i]}" || true)"$'\n'
	done

	denylist="$(denylist_path)"

	if [ -n "${denylist}" ]; then
		literals="$(denylist_literals "${denylist}")"

		if [ -n "${literals}" ]; then
			findings+="$(grep -nIHZiF -- "${literals}" "${files[@]}" | report "a literal from local/dev-details-denylist" || true)"$'\n'
		fi
	fi

	printf '%s' "${findings}" | grep -v '^$' | sort -u -t: -k1,1 -k2,2n || true
}

main() {
	local files=()
	local checked=()
	local file
	local findings

	if [ "${1:-}" = "--warn-if-empty" ]; then
		warn_if_empty
		exit 0
	fi

	if [ "${1:-}" = "--all" ]; then
		while IFS= read -r -d '' file; do
			files+=("${file}")
		done < <(git ls-files -z)
	else
		files=("$@")
	fi

	for file in "${files[@]}"; do
		if [ -f "${file}" ] && ! is_exempt "${file}"; then
			checked+=("${file}")
		fi
	done

	if [ "${#checked[@]}" -eq 0 ]; then
		exit 0
	fi

	findings="$(find_details "${checked[@]}")"

	if [ -n "${findings}" ]; then
		echo "${findings}"
		echo "These lines hold details of a home or dev set-up, which must not be published in this public repository." >&2
		exit 1
	fi
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
	main "$@"
fi
