#!/usr/bin/env bash
# Prints the version .pre-commit-config.yaml pins for a hook repository,
# without its leading v.
#
# Usage: s/checks/hook-version <repository URL>
#
# For a tool that runs both as a pre-commit hook and in CI, so CI installs
# the same version and the hook's `rev` is the one pin to bump. For example,
# `s/checks/hook-version https://github.com/zizmorcore/zizmor-pre-commit`
# prints 1.30.1.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

main() {
	local repository="${1:-}"
	local config="${root}/.pre-commit-config.yaml"
	local version

	if [ -z "${repository}" ]; then
		echo "No repository given. Usage: s/checks/hook-version <repository URL>" >&2
		exit 1
	fi

	version="$(awk -v repository="${repository}" '
		$0 ~ /repo:/ { found = ($NF == repository); next }
		found && /rev:/ { sub(/.*rev: *v?/, ""); print; exit }
	' "${config}")"

	if [ -z "${version}" ]; then
		echo "${config} pins no rev for ${repository}." >&2
		exit 1
	fi

	echo "${version}"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
	main "$@"
fi
