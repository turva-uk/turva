#!/usr/bin/env bash
# Regenerate the fully pinned requirements locks from the `.in` declarations.
#
# Run this after editing api/requirements.in or api/requirements.dev.in, then
# commit the resulting .txt files alongside the .in change. Python version is
# matched to api/Dockerfile.
set -euo pipefail

cd "$(dirname "$0")/.."

# Python versions are matched to the respective Dockerfiles.
uv pip compile api/requirements.in \
	--python-version 3.14 \
	--output-file api/requirements.txt "$@"

uv pip compile api/requirements.dev.in \
	--python-version 3.14 \
	--output-file api/requirements.dev.txt "$@"

uv pip compile docs/requirements.in \
	--python-version 3.14 \
	--output-file docs/requirements.txt "$@"

echo "Locks regenerated. Review the dependency diff before committing."
