#!/usr/bin/env bash
# Checks that each named test suite still collects at least its floor of
# tests, from s/floors/minimums.
#
# Usage: s/floors/tests [--raise] <safety-file|django|vitest|bats>...
#
# Run after a full run of the suites: by ./s/test and ./s/frontend with no
# arguments, and by CI after each suite's own job. A run of part of a suite
# is never held to a floor. The local runners pass --raise, which raises a
# stale floor instead of only reporting it: see s/floors/check.
#
# Safe to run twice: it runs no test.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

main() {
	local options=()
	local counts suite
	local keys=()

	if [ "${1:-}" = "--raise" ]; then
		options=(--raise)
		shift
	fi

	if [ "$#" -eq 0 ]; then
		echo "No suite given. Usage: s/floors/tests [--raise] <safety-file|django|vitest|bats>..." >&2
		exit 1
	fi

	# EOF cannot convey a producer's exit status. Capture the complete scope
	# successfully before a consumer is permitted to publish any floor raise.
	counts="$("${here}/test-counts" "$@")"
	for suite in "$@"; do
		keys+=("${suite}-tests")
	done
	printf '%s\n' "${counts}" | "${here}/check" "${options[@]}" --expect "${keys[@]}"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
	main "$@"
fi
