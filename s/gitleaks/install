#!/usr/bin/env bash
# Downloads the gitleaks release the pre-commit hook pins, checks it against
# gitleaks' published checksums, and installs it into a folder.
#
# Usage: s/gitleaks/install <folder>
#
# CI uses it before s/gitleaks/scan-commits. The version is read from the
# gitleaks `rev` in .pre-commit-config.yaml, so the hook and CI scan with the
# same release, and Dependabot's pre-commit updates bump both at once.
# This release installer supports Linux x86-64 only; the native pre-commit
# hook builds its pinned release independently on other supported platforms.
#
# Safe to run twice: it overwrites the copy it installed before.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

# The shared YAML boundary validates and decodes the manifest pin before it
# can enter a release URL. No independent pin or partial YAML reader here.
pinned_version() {
	bash "${root}/s/checks/hook-version" https://github.com/gitleaks/gitleaks
}

main() (
	set -euo pipefail
	folder="${1:-}"
	staging=""
	umask 077

	if [ -z "${folder}" ] || [ "$#" -ne 1 ]; then
		echo "No folder given. Usage: s/gitleaks/install <folder>" >&2
		exit 1
	fi
	if [ "$(uname -s)" != Linux ] || [ "$(uname -m)" != x86_64 ]; then
		echo "This release installer supports Linux x86-64 only; no download or installation was attempted." >&2
		exit 1
	fi

	version="$(pinned_version)"
	base_url="https://github.com/gitleaks/gitleaks/releases/download/v${version}"
	archive="gitleaks_${version}_linux_x64.tar.gz"
	checksums="gitleaks_${version}_checksums.txt"
	work="$(mktemp -d)"
	trap 'rm -rf -- "${work}"; if [ -n "${staging}" ]; then rm -f -- "${staging}"; fi' EXIT

	echo "Downloading gitleaks ${version}"
	curl -fsSL --connect-timeout 10 --max-time 120 --retry 1 --retry-delay 2 -o "${work}/${archive}" "${base_url}/${archive}"
	curl -fsSL --connect-timeout 10 --max-time 120 --retry 1 --retry-delay 2 -o "${work}/${checksums}" "${base_url}/${checksums}"

	if ! checksum=$(awk -v name="${archive}" '$2 == name { count++; digest = $1; if (NF != 2) invalid = 1 } END { if (count != 1 || invalid) exit 1; print digest }' "${work}/${checksums}") ||
		[[ ! "${checksum}" =~ ^[a-fA-F0-9]{64}$ ]] ||
		! (cd "${work}" && printf '%s  %s\n' "${checksum}" "${archive}" | sha256sum -c - >/dev/null); then
		echo "The download of ${archive} does not match gitleaks' published checksum." >&2
		exit 1
	fi

	tar -xzf "${work}/${archive}" -C "${work}" gitleaks
	if [ "$("${work}/gitleaks" version)" != "${version}" ]; then
		echo "The downloaded binary does not report the pinned gitleaks version; no installation changed." >&2
		exit 1
	fi
	mkdir -p "${folder}"
	folder="$(cd "${folder}" && pwd -P)"
	staging="$(mktemp "${folder}/.gitleaks.XXXXXX")"
	install -m 0755 "${work}/gitleaks" "${staging}"
	mv -f -- "${staging}" "${folder}/gitleaks"

	echo "Installed gitleaks ${version} in ${folder}"
)

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
	main "$@"
fi
