# Environment for CI. Values are deliberately throwaway.
SECRET_KEY="ci-only-not-a-real-secret-key-0000000000"
DEBUG="false"
ALLOWED_HOSTS="localhost,127.0.0.1,web,testserver"
CSRF_TRUSTED_ORIGINS="http://localhost"
LOG_LEVEL="WARNING"
SITE_BASE_URL="http://localhost"

DB_HOST="postgres"
DB_PORT=5432
DB_USER="postgres"
DB_PASSWORD="thisismypassword"
DB_DATABASE="postgres"
DB_SCHEMA="public"
DB_TEST_DATABASE="turva_test"

SESSION_COOKIE_NAME="turva_session"
SESSION_COOKIE_LIFETIME="86400"
# CI drives the Django test client over plain HTTP, so the HTTPS-only
# protections have to be off or every request is answered with a 301 to https
# and every status-code assertion fails. The `check --deploy` CI step proves the
# production defaults are secure, using production-like inputs rather than
# these.
SESSION_COOKIE_SECURE="false"
CSRF_COOKIE_SECURE="false"
SECURE_SSL_REDIRECT="false"

SAFETY_FILE_ROOT="/srv/.turva-data/safety-files"

# Tests assert on django.core.mail.outbox, which the locmem backend populates.
EMAIL_BACKEND="django.core.mail.backends.locmem.EmailBackend"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USE_TLS="false"
SMTP_FROM_ADDRESS="noreply@turva.test"
