# Direct runtime dependencies of the Django application.
#
# `requirements.txt` is the fully resolved lock, generated by `s/lock`. Install
# from the lock, never from this file.

# Django 6.1 is not an LTS release. The LTS in this series will be 6.2, which
# makes the upgrade a minor one from here. Starting on the 5.2 LTS instead would
# mean a major-version upgrade later for the same end state.
django>=6.1.3,<6.2

# psycopg 3, not psycopg2. Django 4.2 onwards supports it and it is the
# maintained line.
psycopg[binary]

# The JSON API the React interface talks to - ADR 0003. Session authentication,
# so CSRF applies to unsafe methods and the existing sessions keep working.
djangorestframework

# Cross-origin headers for development, where Vite serves the interface on a
# different port from Django. In deployment Caddy fronts both, so this is a
# development affordance rather than a production dependency - but installing it
# conditionally would mean settings that differ between environments in a way
# nobody tests.
django-cors-headers

# Request middleware so views can tell an HTMX request from a full page load and
# return a fragment rather than a whole document. Retained while the Django
# templates are still serving screens React has not reached yet; it goes when
# they do.
django-htmx

# Argon2 password hashing, selected first in PASSWORD_HASHERS.
argon2-cffi

# Static file serving from the application process. Caddy could serve them, but
# that would mean the static root is a shared volume between two containers;
# WhiteNoise keeps deployment to one moving part.
whitenoise[brotli]

# WSGI server for deployment.
gunicorn
