# Development and test dependencies.
# `requirements.dev.txt` is the fully resolved lock, generated by `s/lock`.

-r requirements.in

pytest
pytest-django
pytest-cov

# Freezes time for the email verification token tests, which assert behaviour
# at eight hours and ten minutes.
time-machine

# PyYAML and Jinja2 are declared by safety_file/requirements.in, but the test
# suite imports safety_file, so they must be present in the image too.
-r ../safety_file/requirements.in
