# Copy to app/.env and edit. Never commit app/.env.
#
# Anything whose wrong value would be unsafe has no default in settings.py:
# SECRET_KEY and the database credentials must be set or the application refuses
# to start.

# --- Django ---
SECRET_KEY="change-me-this-is-not-a-secret"
DEBUG="true"
ALLOWED_HOSTS="localhost,127.0.0.1,web"
CSRF_TRUSTED_ORIGINS="https://localhost,http://localhost"
LOG_LEVEL="INFO"

# Used to build absolute links in email, where there is no request to derive
# them from.
SITE_BASE_URL="http://localhost"

# --- Database ---
# Only an index over the safety file repositories. Rebuildable from them.
DB_HOST="postgres"
DB_PORT=5432
DB_USER="postgres"
DB_PASSWORD="thisismypassword"
DB_DATABASE="postgres"
DB_SCHEMA="public"
DB_TEST_DATABASE="turva_test"

# --- Sessions ---
SESSION_COOKIE_NAME="turva_session"
SESSION_COOKIE_LIFETIME="86400"
# These default to secure whenever DEBUG is false. Set them explicitly only to
# serve over plain HTTP in a non-debug environment, which should only ever be
# behind a trusted proxy that terminates TLS.
# SESSION_COOKIE_SECURE="false"
# CSRF_COOKIE_SECURE="false"
# SECURE_SSL_REDIRECT="false"

# --- Safety file storage ---
# Where Clinical Safety Management File repositories live. These ARE the data:
# back them up, and never point this at a temporary directory.
SAFETY_FILE_ROOT="/srv/.turva-data/safety-files"

# --- Email ---
# In development, print to the container log instead of sending:
#   EMAIL_BACKEND="django.core.mail.backends.console.EmailBackend"
EMAIL_BACKEND="django.core.mail.backends.console.EmailBackend"
SMTP_HOST="mail.example.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_USE_TLS="true"
SMTP_FROM_ADDRESS="system@example.com"
