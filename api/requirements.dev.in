# Direct development and test dependencies. Declarations only.
# `requirements.dev.txt` is the fully resolved lock, generated by `s/lock`.

-r requirements.in

pytest
pytest-asyncio
pytest-cov
pytest-freezer
httpx
asgi-lifespan

# SQLite driver for the isolated test database.
aiosqlite

# `tests/conftest.py` loads `.env.test`.
python-dotenv

# Used only by `src/async_database_utils.py`, which only `tests/conftest.py`
# imports, for create/drop of the test database. It reaches into
# sqlalchemy-utils private functions (`_set_url_database`, `_sqlite_file_exists`)
# and is what forces the SQLAlchemy < 2.1 bound in requirements.in.
sqlalchemy-utils
