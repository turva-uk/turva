{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strict, and strict about the things that actually bite: an unchecked
       index access is how a hazard list renders `undefined` as a risk level. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true,

    /* One alias, for one way to name a file: `@/components/button/AddButton`
       rather than a chain of `../../`. Vite and Storybook read it from here, so the alias
       is written once. */
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", ".storybook/*.ts", ".storybook/*.tsx"]
}
