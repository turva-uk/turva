{
	default_bind 0.0.0.0
}

localhost {
	# Django serves the whole URL space: HTML pages, static files via WhiteNoise,
	# and any JSON endpoints. Caddy passes everything through and lets Django own
	# its routing.
	#
	# X-Forwarded-Proto is set so Django knows the original request was HTTPS;
	# without it, SECURE_PROXY_SSL_HEADER has nothing to read and Django builds
	# http:// URLs and rejects cross-origin POSTs it should accept.
	reverse_proxy web:8000 {
		header_up X-Forwarded-Proto {scheme}
	}
}
