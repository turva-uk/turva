{
	default_bind 0.0.0.0
}

localhost {
	# The API serves both the HTML interface and the JSON API, so Caddy passes
	# the whole URL space through unchanged and lets FastAPI own the routing.
	# Previously `/api/*` was proxied with `strip_prefix /api` while the app
	# mounted its router *at* `/api/`, which cancelled out incorrectly.
	reverse_proxy api:8000

	#    # Documentation
	#    handle /docs/* {
	#        uri strip_prefix /docs
	#        reverse_proxy docs:8001
	#    }
}
