#!/usr/bin/env bash
# Git's pre-commit hook: runs the pre-commit checks on the staged files, then
# lint-staged when frontend files are staged, and stops the commit if any of
# them fails. Once they pass, it recommends filling this machine's dev-details
# denylist while that is empty, without stopping the commit.
#
# Usage: git runs it before each commit, once ./s/install-hooks has pointed
# core.hooksPath at .githooks. Run by hand, it checks what is staged now.
#
# Safe to run twice: it changes nothing but what the hooks themselves fix.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# The same pre-commit as ./s/lint: the repository's .venv copy first, then
# the one on PATH.
find_pre_commit() {
	if [ -x "${root}/.venv/bin/pre-commit" ]; then
		echo "${root}/.venv/bin/pre-commit"
		return
	fi

	if command -v pre-commit >/dev/null 2>&1; then
		echo "pre-commit"
		return
	fi

	return 1
}

# Whether any staged change is under frontend/. Only then is lint-staged
# needed, so a commit that touches no frontend file needs no Node packages.
frontend_staged() {
	local staged

	staged="$(git -C "${root}" diff --cached --name-only --diff-filter=ACMR -- frontend/)" || return

	[ -n "${staged}" ]
}

# ESLint and Prettier on the staged frontend files, as frontend/package.json's
# lint-staged config sets out. It runs on the host because it asks git which
# files are staged, and the frontend container mounts only frontend/.
run_lint_staged() {
	local lint_staged="${root}/frontend/node_modules/.bin/lint-staged"

	if [ ! -x "${lint_staged}" ]; then
		echo "lint-staged not found, so the commit was stopped. Install the frontend's packages with:" >&2
		echo "  ./s/frontend install" >&2
		exit 1
	fi

	(cd "${root}/frontend" && "${lint_staged}")
}

main() {
	local pre_commit
	local frontend_status=0
	local dev_details="${root}/s/checks/check-dev-details"
	cd "${root}"

	if ! pre_commit="$(find_pre_commit)"; then
		echo "pre-commit not found, so the commit was stopped. Install it with:" >&2
		echo "  python -m venv .venv && .venv/bin/pip install pre-commit" >&2
		exit 1
	fi

	"${pre_commit}" run

	frontend_staged || frontend_status=$?
	case "${frontend_status}" in
		0) run_lint_staged ;;
		1) ;; # No added or changed frontend files.
		*)
			echo "Could not inspect staged frontend files; the commit was stopped." >&2
			return "${frontend_status}"
			;;
	esac

	if [ -x "${dev_details}" ]; then
		"${dev_details}" --warn-if-empty
	fi
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
	main "$@"
fi
